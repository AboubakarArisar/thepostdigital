# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# runtime admin store (contains password hashes — never commit)
/data/admin-users.json

# runtime visitor analytics store
/data/analytics.json

# typescript
*.tsbuildinfo
next-env.d.ts
.next
CLAUDE.md

/.agents*
/.claude*

*.md

*.png

# Metadata icons must ship with the app (they override the *.png rule above)
!app/icon.png
!app/apple-icon.png

# Neon CLI workspace link (machine-local)
.neon
./scripts
/scripts*